# Gemini / Google GenAI API key (required for agents)
GOOGLE_API_KEY=your_api_key_here

# Model used by all agents
GEMINI_MODEL=gemini-3-flash

# Optional: use Vertex AI instead of API key
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_LOCATION=us-central1

# --- GCP persistence (Firestore + GCS) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
GCS_BUCKET_NAME=your-contracts-bucket
FIRESTORE_COLLECTION=contract_sessions
# true = local JSON/disk fallback (no GCP credentials needed)
USE_MOCK_GCP=true

# --- Email (Approve → send DOCX to client) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=legal@example.com
EMAIL_SUBJECT_PREFIX=[Contract Approval]
# true = log email instead of sending
EMAIL_DRY_RUN=true

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Word track changes ---
TRACK_CHANGES_AUTHOR=Negotiation Agent
